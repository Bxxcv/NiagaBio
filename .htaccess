Options -MultiViews
RewriteEngine On

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

RewriteRule ^login/?$ login.html [L]
RewriteRule ^register/?$ register.html [L]
RewriteRule ^chatbot/?$ chatbot.html [L]
RewriteRule ^dashboard/?$ dashboard.html [L]
RewriteRule ^profile/?$ profile.html [L]
RewriteRule ^products/?$ products.html [L]
RewriteRule ^orders/?$ orders.html [L]
RewriteRule ^links/?$ links.html [L]
RewriteRule ^gallery/?$ gallery.html [L]
RewriteRule ^checkout-settings/?$ checkout-settings.html [L]
RewriteRule ^themes/?$ themes.html [L]
RewriteRule ^upgrade/?$ upgrade.html [L]
RewriteRule ^privacy/?$ privacy.html [L]
RewriteRule ^terms/?$ terms.html [L]
RewriteRule ^refund/?$ refund.html [L]
RewriteRule ^maintenance/?$ maintenance.html [L]
RewriteRule ^u/([^/]+)/?$ u.html?username=$1 [L,QSA]
RewriteRule ^checkout/([^/]+)/([^/]+)/?$ checkout.html?username=$1&product=$2 [L,QSA]
